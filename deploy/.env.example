# /opt/billetterie/.env sur le VPS — ne jamais committer ce fichier rempli.

# Domaine(s) pointant vers le VPS (enregistrement DNS A), séparés par des virgules.
# Sans domaine : <IP>.sslip.io (ex. 203.0.113.10.sslip.io), en HTTPS aussi.
DOMAIN=billetterie.exemple.gn, www.billetterie.exemple.gn

# Secrets : générer avec  openssl rand -base64 32
POSTGRES_PASSWORD=
# 32 octets en base64. NE JAMAIS LE CHANGER après la première génération de billets
# (il chiffre les valeurs QR conservées pour la réimpression).
QR_ENCRYPTION_KEY=

# Renseignés par le déploiement automatique
IMAGE=ghcr.io/owner/billetterie
IMAGE_TAG=latest
